# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
RPC_URL_FALLBACK_1=
RPC_URL_FALLBACK_2=

# Optional Helius-only pool for indexed RPC methods such as
# getProgramAccountsV2. When omitted, Helius URLs from RPC_URL/RPC_URL_FALLBACK_*
# and the PNL_* settings are discovered automatically; non-Helius hosts are
# never used for this method.
RPC_INDEXED_URL=
RPC_INDEXED_URL_FALLBACK_1=
RPC_INDEXED_URL_FALLBACK_2=

# Preferred PnL subscription endpoint and optional fallbacks. When set,
# PNL_RPC_URL_ALT takes precedence over PNL_RPC_URL.
PNL_RPC_URL=
PNL_RPC_URL_ALT=
PNL_RPC_URL_FALLBACK=

# Legacy Helius API-key aliases retained for integrations that still need them.
HELIUS_API_KEY=
HELIUS_API_KEY_ALT=
HELIUS_API_KEY_FALLBACK=

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Primary: Claude through the Claude Code CLI on this host (subscription login,
# no API key). Role models in user-config.json are `claude-cli/<opus|sonnet|haiku>`.
# Log in once as the PM2 user: `claude setup-token`, then put the printed token here
# (or rely on `claude auth login`'s stored session).
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CLI_PATH=/home/<user>/.local/bin/claude   # only if `claude` is not found

# Fallback when the CLI is rate-limited or logged out (OpenAI-compatible API,
# OpenRouter by default; model = claudeCliFallbackModel, default google/gemini-3.7-flash)
OPENROUTER_API_KEY=

# Alternative: LM Studio (local) — point the OpenAI-compatible client elsewhere
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=your-model-name-from-lmstudio

# ── API Keys ───────────────────────────────────────────────────────────────────
LPAGENT_API_KEY=your_lpagent_api_key_here

# ── Telegram Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── Misc ───────────────────────────────────────────────────────────────────────
DRY_RUN=false
LOG_LEVEL=info
